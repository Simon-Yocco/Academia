@page "/cursos"
@using DTOs
@using API.Clients
@using Blazor.WebAssembly.Components
@inject IJSRuntime JSRuntime

<PageTitle>Cursos</PageTitle>

<div class="container-fluid">
    <div class="row">
        <div class="col-12">
            <h3 class="mt-3">Cursos</h3>

            @if (!BaseApiClient.EsAdmin)
            {
                <div class="alert alert-warning mt-3">
                    Solo los administradores pueden gestionar cursos.
                </div>
            }
            else
            {
            <div class="mb-3 mt-3 d-flex justify-content-between">
                <button class="btn btn-primary" @onclick="OpenAddModal">
                    + Nuevo Curso
                </button>
                <div class="d-flex" style="width: 350px;">
                    <input type="text" class="form-control me-2" placeholder="Buscar curso..." @bind="filtro" @bind:event="oninput" @onkeyup="HandleKeyUp" />
                    <button class="btn btn-outline-primary" type="button" @onclick="Buscar">Buscar</button>
                </div>
            </div>

            @if (loading)
            {
                <div class="d-flex justify-content-center">
                    <div class="spinner-border" role="status">
                        <span class="visually-hidden">Cargando...</span>
                    </div>
                </div>
            }
            else
            {
                <div class="table-responsive">
                    <table class="table table-striped table-hover">
                        <thead class="table-dark">
                            <tr>
                                <th>Id</th>
                                <th>Año</th>
                                <th>Cupo</th>
                                <th>Descripción</th>
                                <th>Materia</th>
                                <th>Comisión</th>
                                <th>Docente</th>
                                <th>Acciones</th>
                            </tr>
                        </thead>
                        <tbody>
                            @if (lista != null && lista.Any())
                            {
                                @foreach (var item in lista)
                                {
                                    <tr>
                                        <td>@item.ID</td>
                                        <td>@item.AnioCalendario</td>
                                        <td>@item.Cupo</td>
                                        <td>@item.Descripcion</td>
                                        <td>@item.MateriaDescripcion</td>
                                        <td>@item.ComisionDescripcion</td>
                                        <td>@item.DocenteNombreCompleto</td>
                                        <td>
                                            <button class="btn btn-sm btn-outline-primary me-1" @onclick="() => OpenEditModal(item)">
                                                Editar
                                            </button>
                                            <button class="btn btn-sm btn-outline-danger" @onclick="() => ConfirmDelete(item)">
                                                Eliminar
                                            </button>
                                        </td>
                                    </tr>
                                }
                            }
                            else
                            {
                                <tr>
                                    <td colspan="8" class="text-center text-muted py-3">
                                        No se encontraron cursos.
                                    </td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            }
            }
        </div>
    </div>
</div>

<CursoModal @ref="modal" OnChanged="Buscar" />

@code {
    private List<CursoDTO>? lista;
    private bool loading = true;
    private CursoModal modal = null!;
    private string filtro = "";

    protected override async Task OnInitializedAsync()
    {
        if (!BaseApiClient.EsAdmin) return;
        await Buscar();
    }

    private async Task Buscar()
    {
        try
        {
            loading = true;
            if (string.IsNullOrWhiteSpace(filtro))
            {
                var res = await CursoApiClient.GetAllAsync();
                lista = res?.ToList();
            }
            else
            {
                // Consulta al endpoint de búsqueda de la Web API
                var res = await CursoApiClient.GetByCriteriaAsync(filtro);
                lista = res?.ToList();
            }
        }
        catch (Exception ex)
        {
            Console.WriteLine($"Error al buscar cursos: {ex.Message}");
        }
        finally
        {
            loading = false;
        }
    }

    private async Task HandleKeyUp(KeyboardEventArgs e)
    {
        if (e.Key == "Enter")
        {
            await Buscar();
        }
    }

    private async Task OpenAddModal()
    {
        await modal.ShowAddModal();
    }

    private async Task OpenEditModal(CursoDTO item)
    {
        await modal.ShowEditModal(item);
    }

    private async Task ConfirmDelete(CursoDTO item)
    {
        var confirm = await JSRuntime.InvokeAsync<bool>("confirm", 
            $"¿Está seguro que desea eliminar el curso '{item.Descripcion}'?");
        
        if (confirm)
        {
            var ok = await CursoApiClient.DeleteAsync(item.ID);
            if (!ok)
            {
                await JSRuntime.InvokeVoidAsync("alert", "No se pudo eliminar el curso (puede tener inscripciones asociadas).");
            }
            await Buscar();
        }
    }
}
