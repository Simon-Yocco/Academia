@page "/inscripciones"
@using DTOs
@using API.Clients
@using Blazor.WebAssembly.Components
@inject IJSRuntime JSRuntime

<PageTitle>Inscripciones a Cursado</PageTitle>

<div class="container-fluid">
    <div class="row">
        <div class="col-12">
            <h3 class="mt-3">@(BaseApiClient.EsDocente ? "Alumnos de mis Cursos - Calificaciones" : (BaseApiClient.EsAlumno ? "Mis Inscripciones a Cursado" : "Inscripciones a Cursado"))</h3>

            <div class="mb-3 mt-3 d-flex justify-content-between">
                @if (canAdd)
                {
                    <button class="btn btn-primary" @onclick="OpenAddModal">
                        @(BaseApiClient.EsAlumno ? "+ Inscribirme a Curso" : "+ Nueva Inscripción")
                    </button>
                }
                else
                {
                    <div></div>
                }
                <div class="d-flex" style="width: 350px;">
                    <input type="text" class="form-control me-2" placeholder="Buscar inscripción..." @bind="filtro" @bind:event="oninput" @onkeyup="HandleKeyUp" />
                    <button class="btn btn-outline-primary" type="button" @onclick="Buscar">Buscar</button>
                </div>
            </div>

            @if (loading)
            {
                <div class="d-flex justify-content-center">
                    <div class="spinner-border" role="status">
                        <span class="visually-hidden">Cargando...</span>
                    </div>
                </div>
            }
            else
            {
                <div class="table-responsive">
                    <table class="table table-striped table-hover">
                        <thead class="table-dark">
                            <tr>
                                <th>Legajo</th>
                                <th>Alumno</th>
                                <th>Materia</th>
                                <th>Comisión</th>
                                <th>Año</th>
                                <th>Condición</th>
                                <th>Nota</th>
                                @if (canUpdate || canDelete)
                                {
                                    <th>Acciones</th>
                                }
                            </tr>
                        </thead>
                        <tbody>
                            @if (lista != null && lista.Any())
                            {
                                @foreach (var item in lista)
                                {
                                    <tr>
                                        <td>@item.AlumnoLegajo</td>
                                        <td>@item.AlumnoNombreCompleto</td>
                                        <td>@item.MateriaDescripcion</td>
                                        <td>@item.ComisionDescripcion</td>
                                        <td>@item.AnioCalendario</td>
                                        <td>
                                            <span class="badge @GetBadgeClass(item.Condicion)">
                                                @item.Condicion
                                            </span>
                                        </td>
                                        <td>@(item.Nota.HasValue ? item.Nota.Value.ToString() : "-")</td>
                                        @if (canUpdate || canDelete)
                                        {
                                            <td>
                                                @if (canUpdate)
                                                {
                                                    <button class="btn btn-sm btn-outline-primary me-1" @onclick="() => OpenEditModal(item)">
                                                        @(BaseApiClient.EsDocente ? "Cargar Nota" : "Editar")
                                                    </button>
                                                }
                                                @if (canDelete)
                                                {
                                                    <button class="btn btn-sm btn-outline-danger" @onclick="() => ConfirmDelete(item)">
                                                        Dar de baja
                                                    </button>
                                                }
                                            </td>
                                        }
                                    </tr>
                                }
                            }
                            else
                            {
                                <tr>
                                    <td colspan="@((canUpdate || canDelete) ? 8 : 7)" class="text-center text-muted py-3">
                                        No se encontraron inscripciones.
                                    </td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            }
        </div>
    </div>
</div>

<InscripcionModal @ref="modal" OnChanged="Buscar" />

@code {
    private List<AlumnoInscripcionDTO>? lista;
    private bool loading = true;
    private InscripcionModal modal = null!;
    private string filtro = "";

    private bool canAdd = false;
    private bool canUpdate = false;
    private bool canDelete = false;

    protected override async Task OnInitializedAsync()
    {
        // Configuración de permisos igual al patrón de la cátedra
        canAdd = BaseApiClient.EsAdmin || BaseApiClient.EsAlumno;
        canUpdate = BaseApiClient.EsAdmin || BaseApiClient.EsDocente;
        canDelete = BaseApiClient.EsAdmin;

        await Buscar();
    }

    private async Task Buscar()
    {
        try
        {
            loading = true;
            if (BaseApiClient.EsDocente)
            {
                // Traer cursos donde dicta clases este docente
                var todosLosCursos = await CursoApiClient.GetAllAsync();
                var misCursosIds = todosLosCursos
                    .Where(c => c.IDDocente == BaseApiClient.IDPersonaActual)
                    .Select(c => c.ID)
                    .ToHashSet();

                var todas = await InscripcionApiClient.GetAllAsync();
                var misAlumnos = todas.Where(i => misCursosIds.Contains(i.IDCurso));

                if (!string.IsNullOrWhiteSpace(filtro))
                {
                    misAlumnos = misAlumnos.Where(i =>
                        i.AlumnoNombreCompleto.Contains(filtro, StringComparison.OrdinalIgnoreCase) ||
                        i.MateriaDescripcion.Contains(filtro, StringComparison.OrdinalIgnoreCase) ||
                        i.AlumnoLegajo.ToString().Contains(filtro));
                }

                lista = misAlumnos.ToList();
            }
            else if (BaseApiClient.EsAlumno)
            {
                var misInscripciones = await InscripcionApiClient.GetByAlumnoAsync(BaseApiClient.IDPersonaActual);
                if (!string.IsNullOrWhiteSpace(filtro))
                {
                    misInscripciones = misInscripciones.Where(i =>
                        i.MateriaDescripcion.Contains(filtro, StringComparison.OrdinalIgnoreCase) ||
                        i.ComisionDescripcion.Contains(filtro, StringComparison.OrdinalIgnoreCase) ||
                        i.Condicion.Contains(filtro, StringComparison.OrdinalIgnoreCase));
                }
                lista = misInscripciones.ToList();
            }
            else
            {
                if (string.IsNullOrWhiteSpace(filtro))
                {
                    var res = await InscripcionApiClient.GetAllAsync();
                    lista = res?.ToList();
                }
                else
                {
                    var res = await InscripcionApiClient.GetByCriteriaAsync(filtro);
                    lista = res?.ToList();
                }
            }
        }
        catch (Exception ex)
        {
            Console.WriteLine($"Error al buscar inscripciones: {ex.Message}");
        }
        finally
        {
            loading = false;
        }
    }

    private async Task HandleKeyUp(KeyboardEventArgs e)
    {
        if (e.Key == "Enter")
        {
            await Buscar();
        }
    }

    private async Task OpenAddModal()
    {
        await modal.ShowAddModal(BaseApiClient.EsAlumno ? BaseApiClient.IDPersonaActual : 0);
    }

    private async Task OpenEditModal(AlumnoInscripcionDTO item)
    {
        await modal.ShowEditModal(item);
    }

    private async Task ConfirmDelete(AlumnoInscripcionDTO item)
    {
        var confirm = await JSRuntime.InvokeAsync<bool>("confirm",
            $"¿Está seguro que desea dar de baja la inscripción del alumno '{item.AlumnoNombreCompleto}' en '{item.MateriaDescripcion}'?");

        if (confirm)
        {
            await InscripcionApiClient.DeleteAsync(item.ID);
            await Buscar();
        }
    }

    private string GetBadgeClass(string condicion) => condicion switch
    {
        "Inscripto" => "bg-info text-dark",
        "Regular" => "bg-primary",
        "Aprobado" => "bg-success",
        "Libre" => "bg-danger",
        _ => "bg-secondary"
    };
}
