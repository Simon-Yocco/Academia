@page "/usuarios"
@using DTOs
@using API.Clients
@using Blazor.WebAssembly.Components
@inject IJSRuntime JSRuntime
@inject NavigationManager Navigation

<PageTitle>Usuarios</PageTitle>

<div class="container-fluid">
    <div class="row">
        <div class="col-12">
            <h3 class="mt-3">Gestión de Usuarios (Alumnos y Profesores)</h3>

            @if (!BaseApiClient.EsAdmin)
            {
                <div class="alert alert-warning mt-3">
                    Solo los administradores pueden gestionar usuarios.
                </div>
            }
            else
            {
                <div class="mb-3 mt-3 d-flex justify-content-between">
                    <button class="btn btn-primary" @onclick="OpenAddModal">
                        + Nuevo Usuario
                    </button>
                    <div class="d-flex" style="width: 380px;">
                        <input type="text" class="form-control me-2" placeholder="Buscar por nombre, usuario, legajo o rol..." @bind="filtro" @bind:event="oninput" @onkeyup="HandleKeyUp" />
                        <button class="btn btn-outline-primary" type="button" @onclick="Buscar">Buscar</button>
                    </div>
                </div>

                @if (loading)
                {
                    <div class="d-flex justify-content-center my-4">
                        <div class="spinner-border text-primary" role="status">
                            <span class="visually-hidden">Cargando...</span>
                        </div>
                    </div>
                }
                else
                {
                    <div class="table-responsive shadow-sm rounded">
                        <table class="table table-striped table-hover align-middle">
                            <thead class="table-dark">
                                <tr>
                                    <th>Legajo</th>
                                    <th>Apellido y Nombre</th>
                                    <th>Tipo / Rol</th>
                                    <th>Usuario</th>
                                    <th>Email</th>
                                    <th>Estado</th>
                                    <th class="text-center">Acciones</th>
                                </tr>
                            </thead>
                            <tbody>
                                @if (usuariosFiltrados != null && usuariosFiltrados.Any())
                                {
                                    @foreach (var u in usuariosFiltrados)
                                    {
                                        <tr>
                                            <td><strong>@u.Legajo</strong></td>
                                            <td>@u.Apellido, @u.Nombre</td>
                                            <td>
                                                <span class="badge @GetBadgeClass(u.Rol)">
                                                    @u.Rol
                                                </span>
                                            </td>
                                            <td><code>@u.NombreUsuario</code></td>
                                            <td>@u.Email</td>
                                            <td>
                                                @if (u.Habilitado)
                                                {
                                                    <span class="badge bg-success">Habilitado</span>
                                                }
                                                else
                                                {
                                                    <span class="badge bg-secondary">Deshabilitado</span>
                                                }
                                            </td>
                                            <td class="text-center">
                                                <button class="btn btn-sm btn-outline-primary me-1" @onclick="() => OpenEditModal(u)">
                                                    Editar
                                                </button>
                                                <button class="btn btn-sm btn-outline-danger" @onclick="() => ConfirmDelete(u)">
                                                    Eliminar
                                                </button>
                                            </td>
                                        </tr>
                                    }
                                }
                                else
                                {
                                    <tr>
                                        <td colspan="7" class="text-center text-muted py-4">
                                            No se encontraron usuarios.
                                        </td>
                                    </tr>
                                }
                            </tbody>
                        </table>
                    </div>
                }
            }
        </div>
    </div>
</div>

<UsuarioModal @ref="modal" OnChanged="CargarUsuarios" />

@code {
    private List<UsuarioDTO> usuarios = new();
    private List<UsuarioDTO> usuariosFiltrados = new();
    private bool loading = true;
    private UsuarioModal modal = null!;
    private string filtro = string.Empty;

    protected override async Task OnInitializedAsync()
    {
        if (string.IsNullOrEmpty(BaseApiClient.Token))
        {
            Navigation.NavigateTo("login");
            return;
        }

        await CargarUsuarios();
    }

    private async Task CargarUsuarios()
    {
        try
        {
            loading = true;
            var res = await UsuarioApiClient.GetAllAsync();
            usuarios = res.ToList();
            Buscar();
        }
        catch (Exception ex)
        {
            Console.WriteLine($"Error al cargar usuarios: {ex.Message}");
        }
        finally
        {
            loading = false;
        }
    }

    private void Buscar()
    {
        if (string.IsNullOrWhiteSpace(filtro))
        {
            usuariosFiltrados = usuarios;
        }
        else
        {
            var f = filtro.Trim().ToLower();
            usuariosFiltrados = usuarios.Where(u =>
                u.Nombre.ToLower().Contains(f) ||
                u.Apellido.ToLower().Contains(f) ||
                u.NombreUsuario.ToLower().Contains(f) ||
                u.Rol.ToLower().Contains(f) ||
                u.Email.ToLower().Contains(f) ||
                u.Legajo.ToString().Contains(f)
            ).ToList();
        }
    }

    private void HandleKeyUp(KeyboardEventArgs e)
    {
        if (e.Key == "Enter")
        {
            Buscar();
        }
    }

    private async Task OpenAddModal()
    {
        await modal.ShowAddModal();
    }

    private async Task OpenEditModal(UsuarioDTO item)
    {
        await modal.ShowEditModal(item);
    }

    private async Task ConfirmDelete(UsuarioDTO item)
    {
        var confirm = await JSRuntime.InvokeAsync<bool>("confirm",
            $"¿Está seguro que desea eliminar al usuario '{item.NombreUsuario}' ({item.Nombre} {item.Apellido})?");

        if (confirm)
        {
            try
            {
                var ok = await UsuarioApiClient.DeleteAsync(item.ID);
                if (!ok)
                {
                    await JSRuntime.InvokeVoidAsync("alert", "No se pudo eliminar el usuario.");
                }
            }
            catch (Exception ex)
            {
                await JSRuntime.InvokeVoidAsync("alert", $"Error al eliminar: {ex.Message}");
            }
            await CargarUsuarios();
        }
    }

    private string GetBadgeClass(string rol)
    {
        return rol switch
        {
            "Administrador" => "bg-danger",
            "Docente" => "bg-info text-dark",
            "Alumno" => "bg-primary",
            _ => "bg-secondary"
        };
    }
}
