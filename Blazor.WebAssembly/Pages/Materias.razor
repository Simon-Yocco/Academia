@page "/materias"
@using DTOs
@using API.Clients
@using Blazor.WebAssembly.Components
@inject IJSRuntime JSRuntime

<PageTitle>Materias</PageTitle>

<div class="container-fluid">
    <div class="row">
        <div class="col-12">
            <h3 class="mt-3">Materias</h3>

            <div class="mb-3 mt-3 d-flex justify-content-between">
                <button class="btn btn-primary" @onclick="OpenAddModal">
                    + Nueva Materia
                </button>
                <div class="d-flex" style="width: 350px;">
                    <input type="text" class="form-control me-2" placeholder="Buscar materia o plan..." @bind="filtro" @bind:event="oninput" @onkeyup="HandleKeyUp" />
                    <button class="btn btn-outline-primary" type="button" @onclick="Buscar">Buscar</button>
                </div>
            </div>

            @if (loading)
            {
                <div class="d-flex justify-content-center">
                    <div class="spinner-border" role="status">
                        <span class="visually-hidden">Cargando...</span>
                    </div>
                </div>
            }
            else
            {
                <div class="table-responsive">
                    <table class="table table-striped table-hover">
                        <thead class="table-dark">
                            <tr>
                                <th>Id</th>
                                <th>Materia</th>
                                <th>Hs Semanales</th>
                                <th>Hs Totales</th>
                                <th>Plan</th>
                                <th>Acciones</th>
                            </tr>
                        </thead>
                        <tbody>
                            @if (lista != null && lista.Any())
                            {
                                @foreach (var item in lista)
                                {
                                    <tr>
                                        <td>@item.ID</td>
                                        <td>@item.Descripcion</td>
                                        <td>@item.HSSemanales</td>
                                        <td>@item.HSTotales</td>
                                        <td>@item.PlanDescripcion</td>
                                        <td>
                                            <button class="btn btn-sm btn-outline-primary me-1" @onclick="() => OpenEditModal(item)">
                                                Editar
                                            </button>
                                            <button class="btn btn-sm btn-outline-danger" @onclick="() => ConfirmDelete(item)">
                                                Eliminar
                                            </button>
                                        </td>
                                    </tr>
                                }
                            }
                            else
                            {
                                <tr>
                                    <td colspan="6" class="text-center text-muted py-3">
                                        No se encontraron materias.
                                    </td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            }
        </div>
    </div>
</div>

<MateriaModal @ref="modal" OnChanged="Buscar" />

@code {
    private List<MateriaDTO>? lista;
    private bool loading = true;
    private MateriaModal modal = null!;
    private string filtro = "";

    protected override async Task OnInitializedAsync()
    {
        await Buscar();
    }

    private async Task HandleKeyUp(KeyboardEventArgs e)
    {
        if (e.Key == "Enter")
        {
            await Buscar();
        }
    }

    private async Task Buscar()
    {
        try
        {
            loading = true;
            if (string.IsNullOrWhiteSpace(filtro))
            {
                var res = await MateriaApiClient.GetAllAsync();
                lista = res?.ToList();
            }
            else
            {
                var res = await MateriaApiClient.GetByCriteriaAsync(filtro.Trim());
                lista = res?.ToList();
            }
        }
        catch (Exception ex)
        {
            Console.WriteLine($"Error al buscar materias: {ex.Message}");
        }
        finally
        {
            loading = false;
        }
    }

    private async Task OpenAddModal()
    {
        await modal.ShowAddModal();
    }

    private async Task OpenEditModal(MateriaDTO item)
    {
        await modal.ShowEditModal(item);
    }

    private async Task ConfirmDelete(MateriaDTO item)
    {
        var confirm = await JSRuntime.InvokeAsync<bool>("confirm", 
            $"¿Está seguro que desea eliminar la materia {item.Descripcion}?");
        
        if (confirm)
        {
            try
            {
                var ok = await MateriaApiClient.DeleteAsync(item.ID);
                if (!ok)
                {
                    await JSRuntime.InvokeVoidAsync("alert", "No se pudo eliminar la materia (puede tener cursos asociados).");
                }
            }
            catch (Exception ex)
            {
                await JSRuntime.InvokeVoidAsync("alert", $"Error al eliminar: {ex.Message}");
            }
            await Buscar();
        }
    }
}
