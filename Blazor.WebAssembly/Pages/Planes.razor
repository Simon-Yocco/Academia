@page "/planes"
@using DTOs
@using API.Clients
@using Blazor.WebAssembly.Components
@inject IJSRuntime JSRuntime

<PageTitle>Planes de Estudio</PageTitle>

<div class="container-fluid">
    <div class="row">
        <div class="col-12">
            <h3 class="mt-3">Planes de Estudio</h3>

            @if (!BaseApiClient.EsAdmin)
            {
                <div class="alert alert-warning mt-3">
                    Solo los administradores pueden gestionar planes de estudio.
                </div>
            }
            else
            {
            <div class="mb-3 mt-3 d-flex justify-content-between">
                <button class="btn btn-primary" @onclick="OpenAddModal">
                    + Nuevo Plan
                </button>
                <div class="d-flex" style="width: 350px;">
                    <input type="text" class="form-control me-2" placeholder="Buscar plan..." @bind="filtro" @bind:event="oninput" @onkeyup="HandleKeyUp" />
                    <button class="btn btn-outline-primary" type="button" @onclick="Buscar">Buscar</button>
                </div>
            </div>

            @if (loading)
            {
                <div class="d-flex justify-content-center">
                    <div class="spinner-border" role="status">
                        <span class="visually-hidden">Cargando...</span>
                    </div>
                </div>
            }
            else
            {
                <div class="table-responsive">
                    <table class="table table-striped table-hover">
                        <thead class="table-dark">
                            <tr>
                                <th style="width: 80px;">ID</th>
                                <th>Plan</th>
                                <th>Especialidad</th>
                                <th style="width: 150px;">Materias</th>
                                <th style="width: 180px;">Acciones</th>
                            </tr>
                        </thead>
                        <tbody>
                            @if (lista != null && lista.Any())
                            {
                                @foreach (var item in lista)
                                {
                                    <tr>
                                        <td>@item.ID</td>
                                        <td><strong>@item.Descripcion</strong></td>
                                        <td>@(!string.IsNullOrEmpty(item.EspecialidadDescripcion) ? item.EspecialidadDescripcion : item.IDEspecialidad.ToString())</td>
                                        <td>
                                            <span class="badge bg-info text-dark">
                                                @(item.Materias != null ? item.Materias.Count : 0) materias
                                            </span>
                                        </td>
                                        <td>
                                            <button class="btn btn-sm btn-outline-primary me-1" @onclick="() => OpenEditModal(item)">
                                                Editar
                                            </button>
                                            <button class="btn btn-sm btn-outline-danger" @onclick="() => ConfirmDelete(item)">
                                                Eliminar
                                            </button>
                                        </td>
                                    </tr>
                                }
                            }
                            else
                            {
                                <tr>
                                    <td colspan="5" class="text-center text-muted py-3">
                                        No se encontraron planes registrados.
                                    </td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            }
            }
        </div>
    </div>
</div>

<PlanModal @ref="modal" OnChanged="Buscar" />

@code {
    private List<PlanDTO>? lista;
    private bool loading = true;
    private PlanModal modal = null!;
    private string filtro = "";

    protected override async Task OnInitializedAsync()
    {
        if (!BaseApiClient.EsAdmin) return;
        await Buscar();
    }

    private async Task HandleKeyUp(KeyboardEventArgs e)
    {
        if (e.Key == "Enter")
        {
            await Buscar();
        }
    }

    private async Task Buscar()
    {
        try
        {
            loading = true;
            if (string.IsNullOrWhiteSpace(filtro))
            {
                var res = await PlanApiClient.GetAllAsync();
                lista = res?.ToList();
            }
            else
            {
                var res = await PlanApiClient.GetByCriteriaAsync(filtro.Trim());
                lista = res?.ToList();
            }
        }
        catch (Exception ex)
        {
            Console.WriteLine($"Error al buscar planes: {ex.Message}");
        }
        finally
        {
            loading = false;
        }
    }

    private async Task OpenAddModal()
    {
        await modal.ShowAddModal();
    }

    private async Task OpenEditModal(PlanDTO item)
    {
        await modal.ShowEditModal(item);
    }

    private async Task ConfirmDelete(PlanDTO item)
    {
        var confirm = await JSRuntime.InvokeAsync<bool>("confirm", 
            $"¿Está seguro que desea eliminar el plan '{item.Descripcion}' junto con todas sus materias?");
        
        if (confirm)
        {
            var ok = await PlanApiClient.DeleteAsync(item.ID);
            if (!ok)
            {
                await JSRuntime.InvokeVoidAsync("alert", "No se pudo eliminar el plan (puede tener comisiones, cursos o personas asociadas).");
            }
            await Buscar();
        }
    }
}
