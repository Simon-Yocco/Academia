@page "/planes"
@using DTOs
@using API.Clients
@using Blazor.WebAssembly.Components
@inject IJSRuntime JSRuntime

<PageTitle>Planes de Estudio</PageTitle>

<div class="container-fluid">
    <div class="row">
        <div class="col-12">
            <h3 class="mt-3">Planes de Estudio</h3>

            <div class="mb-3 mt-3 d-flex justify-content-between">
                <button class="btn btn-primary" @onclick="OpenAddModal">
                    + Nuevo Plan
                </button>
                <div style="width: 300px;">
                    <input type="text" class="form-control" placeholder="Buscar plan..." @bind="filtro" @bind:event="oninput" />
                </div>
            </div>

            @if (loading)
            {
                <div class="d-flex justify-content-center">
                    <div class="spinner-border" role="status">
                        <span class="visually-hidden">Cargando...</span>
                    </div>
                </div>
            }
            else
            {
                <div class="table-responsive">
                    <table class="table table-striped table-hover">
                        <thead class="table-dark">
                            <tr>
                                <th style="width: 80px;">ID</th>
                                <th>Plan</th>
                                <th>Cód. Especialidad</th>
                                <th style="width: 150px;">Materias</th>
                                <th style="width: 180px;">Acciones</th>
                            </tr>
                        </thead>
                        <tbody>
                            @if (listaFiltrada != null && listaFiltrada.Any())
                            {
                                @foreach (var item in listaFiltrada)
                                {
                                    <tr>
                                        <td>@item.ID</td>
                                        <td><strong>@item.Descripcion</strong></td>
                                        <td>@item.IDEspecialidad</td>
                                        <td>
                                            <span class="badge bg-info text-dark">
                                                @(item.Materias != null ? item.Materias.Count : 0) materias
                                            </span>
                                        </td>
                                        <td>
                                            <button class="btn btn-sm btn-outline-primary me-1" @onclick="() => OpenEditModal(item)">
                                                Editar
                                            </button>
                                            <button class="btn btn-sm btn-outline-danger" @onclick="() => ConfirmDelete(item)">
                                                Eliminar
                                            </button>
                                        </td>
                                    </tr>
                                }
                            }
                            else
                            {
                                <tr>
                                    <td colspan="5" class="text-center text-muted py-3">
                                        No se encontraron planes registrados.
                                    </td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            }
        </div>
    </div>
</div>

<PlanModal @ref="modal" OnChanged="LoadData" />

@code {
    private List<PlanDTO>? lista;
    private bool loading = true;
    private PlanModal modal = null!;

    private string filtro = "";
    private IEnumerable<PlanDTO>? listaFiltrada => 
        string.IsNullOrEmpty(filtro) ? lista : lista?.Where(p => p.Descripcion != null && p.Descripcion.Contains(filtro, StringComparison.OrdinalIgnoreCase));

    protected override async Task OnInitializedAsync()
    {
        await LoadData();
    }

    private async Task LoadData()
    {
        try
        {
            loading = true;
            var res = await PlanApiClient.GetAllAsync();
            lista = res?.ToList();
        }
        catch (Exception ex)
        {
            Console.WriteLine(ex.Message);
        }
        finally
        {
            loading = false;
        }
    }

    private async Task OpenAddModal()
    {
        await modal.ShowAddModal();
    }

    private async Task OpenEditModal(PlanDTO item)
    {
        await modal.ShowEditModal(item);
    }

    private async Task ConfirmDelete(PlanDTO item)
    {
        var confirm = await JSRuntime.InvokeAsync<bool>("confirm", 
            $"¿Está seguro que desea eliminar el plan '{item.Descripcion}' junto con todas sus materias?");
        
        if (confirm)
        {
            await PlanApiClient.DeleteAsync(item.ID);
            await LoadData();
        }
    }
}
