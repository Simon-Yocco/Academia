@page "/especialidades"
@using DTOs
@using API.Clients
@using Blazor.WebAssembly.Components
@inject IJSRuntime JSRuntime

<PageTitle>Especialidades</PageTitle>

<div class="container-fluid">
    <div class="row">
        <div class="col-12">
            <h3 class="mt-3">Especialidades</h3>

            <div class="mb-3 mt-3 d-flex justify-content-between">
                <button class="btn btn-primary" @onclick="OpenAddModal">
                    Agregar
                </button>
                <div style="width: 300px;">
                    <input type="text" class="form-control" placeholder="Buscar especialidad..." @bind="filtro" @bind:event="oninput" />
                </div>
            </div>

            @if (loading)
            {
                <div class="d-flex justify-content-center">
                    <div class="spinner-border" role="status">
                        <span class="visually-hidden">Cargando...</span>
                    </div>
                </div>
            }
            else
            {
                <div class="table-responsive">
                    <table class="table table-striped table-hover">
                        <thead class="table-dark">
                            <tr>
                                <th>Id</th>
                                <th>Descripción</th>
                                <th></th>
                            </tr>
                        </thead>
                        <tbody>
                            @if (listaFiltrada != null && listaFiltrada.Any())
                            {
                                @foreach (var item in listaFiltrada)
                                {
                                    <tr>
                                        <td>@item.ID</td>
                                        <td>@item.Descripcion</td>
                                        <td>
                                            <button class="btn btn-sm btn-outline-primary me-1" @onclick="() => OpenEditModal(item)">
                                                Editar
                                            </button>
                                            <button class="btn btn-sm btn-outline-danger" @onclick="() => ConfirmDelete(item)">
                                                Eliminar
                                            </button>
                                        </td>
                                    </tr>
                                }
                            }
                        </tbody>
                    </table>
                </div>
            }
        </div>
    </div>
</div>

<EspecialidadModal @ref="modal" OnChanged="LoadData" />

@code {
    private List<EspecialidadDTO>? lista;
    private bool loading = true;
    private EspecialidadModal modal = null!;

    private string filtro = "";
    private IEnumerable<EspecialidadDTO>? listaFiltrada => 
        string.IsNullOrEmpty(filtro) ? lista : lista?.Where(c => c.Descripcion != null && c.Descripcion.Contains(filtro, StringComparison.OrdinalIgnoreCase));

    protected override async Task OnInitializedAsync()
    {
        await LoadData();
    }

    private async Task LoadData()
    {
        try
        {
            loading = true;
            var res = await EspecialidadApiClient.GetAllAsync();
            lista = res?.ToList();
        }
        catch (Exception ex)
        {
            Console.WriteLine(ex.Message);
        }
        finally
        {
            loading = false;
        }
    }

    private void OpenAddModal()
    {
        modal.ShowAddModal();
    }

    private void OpenEditModal(EspecialidadDTO item)
    {
        modal.ShowEditModal(item);
    }

    private async Task ConfirmDelete(EspecialidadDTO item)
    {
        var confirm = await JSRuntime.InvokeAsync<bool>("confirm", 
            $"¿Está seguro que desea eliminar la especialidad {item.Descripcion}?");
        
        if (confirm)
        {
            await EspecialidadApiClient.DeleteAsync(item.ID);
            await LoadData();
        }
    }
}
