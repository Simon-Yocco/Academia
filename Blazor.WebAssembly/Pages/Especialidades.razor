@page "/especialidades"
@using DTOs
@using API.Clients
@using Blazor.WebAssembly.Components
@inject IJSRuntime JSRuntime

<PageTitle>Especialidades</PageTitle>

<div class="container-fluid">
    <div class="row">
        <div class="col-12">
            <h3 class="mt-3">Especialidades</h3>

            <div class="mb-3 mt-3 d-flex justify-content-between">
                <button class="btn btn-primary" @onclick="OpenAddModal">
                    Agregar
                </button>
                <div class="d-flex" style="width: 350px;">
                    <input type="text" class="form-control me-2" placeholder="Buscar especialidad..." @bind="filtro" @bind:event="oninput" @onkeyup="HandleKeyUp" />
                    <button class="btn btn-outline-primary" type="button" @onclick="Buscar">Buscar</button>
                </div>
            </div>

            @if (loading)
            {
                <div class="d-flex justify-content-center">
                    <div class="spinner-border" role="status">
                        <span class="visually-hidden">Cargando...</span>
                    </div>
                </div>
            }
            else
            {
                <div class="table-responsive">
                    <table class="table table-striped table-hover">
                        <thead class="table-dark">
                            <tr>
                                <th>Id</th>
                                <th>Descripción</th>
                                <th></th>
                            </tr>
                        </thead>
                        <tbody>
                            @if (lista != null && lista.Any())
                            {
                                @foreach (var item in lista)
                                {
                                    <tr>
                                        <td>@item.ID</td>
                                        <td>@item.Descripcion</td>
                                        <td>
                                            <button class="btn btn-sm btn-outline-primary me-1" @onclick="() => OpenEditModal(item)">
                                                Editar
                                            </button>
                                            <button class="btn btn-sm btn-outline-danger" @onclick="() => ConfirmDelete(item)">
                                                Eliminar
                                            </button>
                                        </td>
                                    </tr>
                                }
                            }
                            else
                            {
                                <tr>
                                    <td colspan="3" class="text-center text-muted py-3">
                                        No se encontraron especialidades.
                                    </td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            }
        </div>
    </div>
</div>

<EspecialidadModal @ref="modal" OnChanged="Buscar" />

@code {
    private List<EspecialidadDTO>? lista;
    private bool loading = true;
    private EspecialidadModal modal = null!;
    private string filtro = "";

    protected override async Task OnInitializedAsync()
    {
        await Buscar();
    }

    private async Task HandleKeyUp(KeyboardEventArgs e)
    {
        if (e.Key == "Enter")
        {
            await Buscar();
        }
    }

    private async Task Buscar()
    {
        try
        {
            loading = true;
            if (string.IsNullOrWhiteSpace(filtro))
            {
                var res = await EspecialidadApiClient.GetAllAsync();
                lista = res?.ToList();
            }
            else
            {
                var res = await EspecialidadApiClient.GetByCriteriaAsync(filtro.Trim());
                lista = res?.ToList();
            }
        }
        catch (Exception ex)
        {
            Console.WriteLine($"Error al buscar especialidades: {ex.Message}");
        }
        finally
        {
            loading = false;
        }
    }

    private void OpenAddModal()
    {
        modal.ShowAddModal();
    }

    private void OpenEditModal(EspecialidadDTO item)
    {
        modal.ShowEditModal(item);
    }

    private async Task ConfirmDelete(EspecialidadDTO item)
    {
        var confirm = await JSRuntime.InvokeAsync<bool>("confirm", 
            $"¿Está seguro que desea eliminar la especialidad {item.Descripcion}?");
        
        if (confirm)
        {
            await EspecialidadApiClient.DeleteAsync(item.ID);
            await Buscar();
        }
    }
}
