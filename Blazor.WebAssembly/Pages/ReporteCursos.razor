@page "/reporte-cursos"
@using DTOs
@using API.Clients
@inject NavigationManager Navigation

<PageTitle>Reporte de Cursos y Ocupación</PageTitle>

<div class="container-fluid py-3">
    <div class="d-flex justify-content-between align-items-center mb-3">
        <h3 class="mb-0">📊 Reporte de Cursos y Ocupación</h3>
        <button class="btn btn-outline-primary" @onclick="CargarReporte" disabled="@loading">
            🔄 Recargar
        </button>
    </div>

    @if (loading)
    {
        <div class="d-flex justify-content-center py-5">
            <div class="spinner-border text-primary" role="status">
                <span class="visually-hidden">Cargando...</span>
            </div>
        </div>
    }
    else if (!string.IsNullOrEmpty(errorMsg))
    {
        <div class="alert alert-danger shadow-sm">
            @errorMsg
        </div>
    }
    else if (datos == null || !datos.Any())
    {
        <div class="alert alert-info shadow-sm">
            No hay cursos registrados para mostrar en el reporte.
        </div>
    }
    else
    {
        <!-- BARRA DE FILTRO POR MATERIA -->
        <div class="card mb-3 shadow-sm border-0 bg-light">
            <div class="card-body py-2">
                <div class="row align-items-center g-2">
                    <div class="col-auto">
                        <label class="col-form-label fw-bold">Materia:</label>
                    </div>
                    <div class="col-md-5">
                        <select class="form-select" @bind="materiaSeleccionada" @bind:after="FiltrarPorMateria">
                            <option value="">-- Seleccione una materia --</option>
                            @foreach (var mat in materiasDisponibles)
                            {
                                <option value="@mat">@mat</option>
                            }
                        </select>
                    </div>
                </div>
            </div>
        </div>

        @if (string.IsNullOrEmpty(materiaSeleccionada))
        {
            <div class="alert alert-secondary text-center py-5 shadow-sm">
                <h5>ℹ️ Seleccione una materia arriba para ver el reporte y el gráfico de sus comisiones.</h5>
            </div>
        }
        else if (!cursosFiltrados.Any())
        {
            <div class="alert alert-warning text-center py-4 shadow-sm">
                No se encontraron comisiones para la materia seleccionada.
            </div>
        }
        else
        {
            <!-- GRÁFICO COMPARATIVO EN SVG PURO -->
            <div class="card mb-4 shadow-sm">
                <div class="card-header bg-dark text-white d-flex justify-content-between align-items-center">
                    <span>Gráfico Comparativo: Cupo Máximo vs. Alumnos Inscriptos (@materiaSeleccionada)</span>
                    <div class="small">
                        <span class="badge bg-primary me-2">■ Cupo Máximo</span>
                        <span class="badge bg-success">■ Alumnos Inscriptos</span>
                    </div>
                </div>
                <div class="card-body p-3">
                    @{
                        int maxVal = Math.Max(cursosFiltrados.Max(d => Math.Max(d.CupoTotal, d.Inscriptos)), 10);
                        maxVal = (int)(Math.Ceiling(maxVal / 10.0) * 10);
                        int svgWidth = Math.Max(800, cursosFiltrados.Count * 140);
                        int svgHeight = 290;
                        int padTop = 30;
                        int padBottom = 60;
                        int padLeft = 45;
                        int chartH = svgHeight - padTop - padBottom;
                        int chartW = svgWidth - padLeft - 20;
                        int groupW = chartW / cursosFiltrados.Count;
                        int barW = Math.Min((int)Math.Round(groupW * 0.35), 40);
                    }

                    <div class="table-responsive">
                        <svg viewBox="0 0 @svgWidth @svgHeight" style="width: 100%; min-width: 700px; height: 310px;">
                            <!-- Líneas guía horizontales y valores del eje Y -->
                            @for (int i = 0; i <= 4; i++)
                            {
                                int val = (maxVal * i) / 4;
                                int y = padTop + chartH - (int)Math.Round((double)val / maxVal * chartH);
                                <line x1="@padLeft" y1="@y" x2="@(padLeft + chartW)" y2="@y" stroke="#e9ecef" stroke-width="1" />
                                @((MarkupString)$"<text x=\"{padLeft - 8}\" y=\"{y + 4}\" font-size=\"11\" fill=\"#6c757d\" text-anchor=\"end\">{val}</text>")
                            }

                            <!-- Barras comparativas por comisión -->
                            @for (int idx = 0; idx < cursosFiltrados.Count; idx++)
                            {
                                var c = cursosFiltrados[idx];
                                int groupX = padLeft + idx * groupW + (groupW - (barW * 2 + 6)) / 2;
                                int hCupo = (int)Math.Round(((double)c.CupoTotal / maxVal) * chartH);
                                int yCupo = padTop + chartH - hCupo;
                                int hIns = (int)Math.Round(((double)c.Inscriptos / maxVal) * chartH);
                                int yIns = padTop + chartH - hIns;

                                int xCupoText = groupX + barW / 2;
                                int yCupoText = yCupo - 5;

                                int xInsBar = groupX + barW + 6;
                                int xInsText = xInsBar + barW / 2;
                                int yInsText = yIns - 5;

                                int xLabel = padLeft + idx * groupW + groupW / 2;
                                int yLabelComision = padTop + chartH + 20;
                                int yLabelAnio = padTop + chartH + 36;

                                <!-- Barra Cupo Máximo -->
                                <rect x="@groupX" y="@yCupo" width="@barW" height="@hCupo" fill="#0d6efd" rx="3">
                                    <title>Comisión @c.Comision - Cupo Máximo: @c.CupoTotal</title>
                                </rect>
                                @((MarkupString)$"<text x=\"{xCupoText}\" y=\"{yCupoText}\" font-size=\"11\" fill=\"#0d6efd\" text-anchor=\"middle\" font-weight=\"bold\">{c.CupoTotal}</text>")

                                <!-- Barra Alumnos Inscriptos -->
                                <rect x="@xInsBar" y="@yIns" width="@barW" height="@hIns" fill="#198754" rx="3">
                                    <title>Comisión @c.Comision - Inscriptos: @c.Inscriptos</title>
                                </rect>
                                @((MarkupString)$"<text x=\"{xInsText}\" y=\"{yInsText}\" font-size=\"11\" fill=\"#198754\" text-anchor=\"middle\" font-weight=\"bold\">{c.Inscriptos}</text>")

                                <!-- Etiquetas eje X -->
                                @((MarkupString)$"<text x=\"{xLabel}\" y=\"{yLabelComision}\" font-size=\"11\" fill=\"#212529\" text-anchor=\"middle\" font-weight=\"500\">Comisión {c.Comision}</text>")
                                @((MarkupString)$"<text x=\"{xLabel}\" y=\"{yLabelAnio}\" font-size=\"10\" fill=\"#6c757d\" text-anchor=\"middle\">({c.AnioCalendario})</text>")
                            }
                        </svg>
                    </div>
                </div>
            </div>

            <!-- TABLA DETALLADA -->
            <div class="card shadow-sm">
                <div class="card-header bg-light">
                    <h5 class="mb-0">Comisiones de @materiaSeleccionada</h5>
                </div>
                <div class="table-responsive">
                    <table class="table table-hover align-middle mb-0">
                        <thead class="table-dark">
                            <tr>
                                <th>Materia</th>
                                <th>Comisión</th>
                                <th>Año</th>
                                <th>Docente</th>
                                <th class="text-center">Cupo Máx.</th>
                                <th class="text-center">Inscriptos</th>
                                <th>% Ocupación</th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var c in cursosFiltrados)
                            {
                                <tr>
                                    <td><strong>@c.Materia</strong></td>
                                    <td>@c.Comision</td>
                                    <td>@c.AnioCalendario</td>
                                    <td>@c.Docente</td>
                                    <td class="text-center"><span class="badge bg-primary">@c.CupoTotal</span></td>
                                    <td class="text-center"><span class="badge bg-success">@c.Inscriptos</span></td>
                                    <td style="width: 220px;">
                                        <div class="d-flex align-items-center">
                                            <div class="progress flex-grow-1 me-2" style="height: 20px;">
                                                <div class="progress-bar @GetProgressClass(c.PorcentajeOcupacion)" 
                                                     role="progressbar" 
                                                     style="width: @((int)Math.Round(Math.Min(c.PorcentajeOcupacion, 100)))%">
                                                    @c.PorcentajeOcupacion%
                                                </div>
                                            </div>
                                        </div>
                                    </td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            </div>
        }
    }
</div>

@code {
    private List<CursoOcupacionDTO>? datos;
    private List<string> materiasDisponibles = new();
    private List<CursoOcupacionDTO> cursosFiltrados = new();
    private string materiaSeleccionada = "";
    private string errorMsg = "";
    private bool loading = true;

    protected override async Task OnInitializedAsync()
    {
        if (string.IsNullOrEmpty(BaseApiClient.Token))
        {
            Navigation.NavigateTo("login");
            return;
        }

        await CargarReporte();
    }

    private async Task CargarReporte()
    {
        try
        {
            loading = true;
            errorMsg = "";
            datos = await ReporteApiClient.GetCursosOcupacionAsync();

            materiasDisponibles = (datos ?? new())
                .Select(c => c.Materia)
                .Where(m => !string.IsNullOrWhiteSpace(m))
                .Distinct()
                .OrderBy(m => m)
                .ToList();

            FiltrarPorMateria();
        }
        catch (Exception ex)
        {
            errorMsg = $"Error al cargar reporte: {ex.Message}";
        }
        finally
        {
            loading = false;
        }
    }

    private void FiltrarPorMateria()
    {
        if (string.IsNullOrEmpty(materiaSeleccionada) || datos == null)
        {
            cursosFiltrados = new();
        }
        else
        {
            cursosFiltrados = datos
                .Where(c => c.Materia.Equals(materiaSeleccionada, StringComparison.OrdinalIgnoreCase))
                .ToList();
        }
    }

    private string GetProgressClass(double pct) => pct switch
    {
        >= 100 => "bg-danger",
        >= 80 => "bg-warning text-dark",
        _ => "bg-success"
    };
}
