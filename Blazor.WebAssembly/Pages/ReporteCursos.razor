@page "/reporte-cursos"
@using DTOs
@using API.Clients
@inject NavigationManager Navigation

<PageTitle>Reporte de Cursos y Ocupación</PageTitle>

<div class="container-fluid py-3">
    <div class="d-flex justify-content-between align-items-center mb-3">
        <h3 class="mb-0">📊 Reporte de Cursos y Ocupación</h3>
        <button class="btn btn-outline-primary" @onclick="CargarReporte" disabled="@loading">
            🔄 Recargar
        </button>
    </div>

    @if (loading)
    {
        <div class="d-flex justify-content-center py-5">
            <div class="spinner-border text-primary" role="status">
                <span class="visually-hidden">Cargando...</span>
            </div>
        </div>
    }
    else if (datos == null || !datos.Any())
    {
        <div class="alert alert-info shadow-sm">
            No hay cursos registrados para mostrar en el reporte.
        </div>
    }
    else
    {
        <!-- GRÁFICO COMPARATIVO EN SVG PURO -->
        <div class="card mb-4 shadow-sm">
            <div class="card-header bg-dark text-white d-flex justify-content-between align-items-center">
                <span>Gráfico Comparativo: Cupo Máximo vs. Alumnos Inscriptos</span>
                <div class="small">
                    <span class="badge bg-primary me-2">■ Cupo Máximo</span>
                    <span class="badge bg-success">■ Alumnos Inscriptos</span>
                </div>
            </div>
            <div class="card-body p-3">
                @{
                    int maxVal = Math.Max(datos.Max(d => Math.Max(d.CupoTotal, d.Inscriptos)), 10);
                    maxVal = (int)(Math.Ceiling(maxVal / 10.0) * 10);
                    int svgWidth = Math.Max(800, datos.Count * 110);
                    int svgHeight = 290;
                    int padTop = 30;
                    int padBottom = 60;
                    int padLeft = 45;
                    int chartH = svgHeight - padTop - padBottom;
                    int chartW = svgWidth - padLeft - 20;
                    float groupW = (float)chartW / datos.Count;
                    float barW = Math.Min(groupW * 0.35f, 32f);
                }

                <div class="table-responsive">
                    <svg viewBox="0 0 @svgWidth @svgHeight" style="width: 100%; min-width: 700px; height: 310px;">
                        <!-- Líneas guía horizontales y valores del eje Y -->
                        @for (int i = 0; i <= 4; i++)
                        {
                            int val = (maxVal * i) / 4;
                            float y = padTop + chartH - ((float)val / maxVal * chartH);
                            <line x1="@padLeft" y1="@y" x2="@(padLeft + chartW)" y2="@y" stroke="#e9ecef" stroke-width="1" />
                            @((MarkupString)$"<text x=\"{padLeft - 8}\" y=\"{y + 4}\" font-size=\"11\" fill=\"#6c757d\" text-anchor=\"end\">{val}</text>")
                        }

                        <!-- Barras comparativas por curso -->
                        @for (int idx = 0; idx < datos.Count; idx++)
                        {
                            var c = datos[idx];
                            float groupX = padLeft + idx * groupW + (groupW - (barW * 2 + 6)) / 2;
                            float hCupo = ((float)c.CupoTotal / maxVal) * chartH;
                            float yCupo = padTop + chartH - hCupo;
                            float hIns = ((float)c.Inscriptos / maxVal) * chartH;
                            float yIns = padTop + chartH - hIns;

                            <!-- Barra Cupo Máximo -->
                            <rect x="@groupX" y="@yCupo" width="@barW" height="@hCupo" fill="#0d6efd" rx="3">
                                <title>@c.Materia (@c.Comision) - Cupo Máximo: @c.CupoTotal</title>
                            </rect>
                            @((MarkupString)$"<text x=\"{groupX + barW / 2}\" y=\"{yCupo - 5}\" font-size=\"11\" fill=\"#0d6efd\" text-anchor=\"middle\" font-weight=\"bold\">{c.CupoTotal}</text>")

                            <!-- Barra Alumnos Inscriptos -->
                            <rect x="@(groupX + barW + 6)" y="@yIns" width="@barW" height="@hIns" fill="#198754" rx="3">
                                <title>@c.Materia (@c.Comision) - Inscriptos: @c.Inscriptos</title>
                            </rect>
                            @((MarkupString)$"<text x=\"{groupX + barW + 6 + barW / 2}\" y=\"{yIns - 5}\" font-size=\"11\" fill=\"#198754\" text-anchor=\"middle\" font-weight=\"bold\">{c.Inscriptos}</text>")

                            <!-- Etiquetas eje X -->
                            @((MarkupString)$"<text x=\"{padLeft + idx * groupW + groupW / 2}\" y=\"{padTop + chartH + 20}\" font-size=\"11\" fill=\"#212529\" text-anchor=\"middle\" font-weight=\"500\">{c.Materia}</text>")
                            @((MarkupString)$"<text x=\"{padLeft + idx * groupW + groupW / 2}\" y=\"{padTop + chartH + 36}\" font-size=\"10\" fill=\"#6c757d\" text-anchor=\"middle\">({c.Comision})</text>")
                        }
                    </svg>
                </div>
            </div>
        </div>

        <!-- TABLA DETALLADA -->
        <div class="card shadow-sm">
            <div class="card-header bg-light">
                <h5 class="mb-0">Detalle de Cursos y Ocupación</h5>
            </div>
            <div class="table-responsive">
                <table class="table table-hover align-middle mb-0">
                    <thead class="table-dark">
                        <tr>
                            <th>Materia</th>
                            <th>Comisión</th>
                            <th>Año</th>
                            <th>Docente</th>
                            <th class="text-center">Cupo Máx.</th>
                            <th class="text-center">Inscriptos</th>
                            <th>% Ocupación</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var c in datos)
                        {
                            <tr>
                                <td><strong>@c.Materia</strong></td>
                                <td>@c.Comision</td>
                                <td>@c.AnioCalendario</td>
                                <td>@c.Docente</td>
                                <td class="text-center"><span class="badge bg-primary">@c.CupoTotal</span></td>
                                <td class="text-center"><span class="badge bg-success">@c.Inscriptos</span></td>
                                <td style="width: 220px;">
                                    <div class="d-flex align-items-center">
                                        <div class="progress flex-grow-1 me-2" style="height: 20px;">
                                            <div class="progress-bar @GetProgressClass(c.PorcentajeOcupacion)" 
                                                 role="progressbar" 
                                                 style="width: @Math.Min(c.PorcentajeOcupacion, 100)%">
                                                @c.PorcentajeOcupacion%
                                            </div>
                                        </div>
                                    </div>
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        </div>
    }
</div>

@code {
    private List<CursoOcupacionDTO>? datos;
    private bool loading = true;

    protected override async Task OnInitializedAsync()
    {
        if (string.IsNullOrEmpty(BaseApiClient.Token))
        {
            Navigation.NavigateTo("login");
            return;
        }

        await CargarReporte();
    }

    private async Task CargarReporte()
    {
        try
        {
            loading = true;
            datos = await ReporteApiClient.GetCursosOcupacionAsync();
        }
        catch (Exception ex)
        {
            Console.WriteLine($"Error al cargar reporte: {ex.Message}");
        }
        finally
        {
            loading = false;
        }
    }

    private string GetProgressClass(double pct) => pct switch
    {
        >= 100 => "bg-danger",
        >= 80 => "bg-warning text-dark",
        _ => "bg-success"
    };
}
