@page "/login"
@using DTOs
@using API.Clients
@inject NavigationManager NavigationManager

<PageTitle>Login</PageTitle>

<div class="row justify-content-center mt-5">
    <div class="col-md-4">
        <div class="card shadow-sm">
            <div class="card-header bg-white">
                <h3 class="text-center m-2">Iniciar Sesión</h3>
            </div>
            <div class="card-body p-4">
                <form @onsubmit="Ingresar" @onsubmit:preventDefault="true">
                    <div class="form-group mb-3">
                        <label for="username">Usuario:</label>
                        <input id="username" class="form-control" @bind="username" />
                    </div>

                    <div class="form-group mb-4">
                        <label for="password">Contraseña:</label>
                        <input id="password" type="password" class="form-control" @bind="password" />
                    </div>

                    @if (!string.IsNullOrEmpty(errorMessage))
                    {
                        <div class="alert alert-danger">@errorMessage</div>
                    }

                    <div class="d-grid">
                        <button type="submit" class="btn btn-primary" disabled="@isLoading">
                            @if (isLoading)
                            {
                                <span class="spinner-border spinner-border-sm me-2"></span>
                            }
                            Ingresar
                        </button>
                    </div>
                </form>
            </div>
        </div>
    </div>
</div>

@code {
    private string username = "";
    private string password = "";
    private string errorMessage = "";
    private bool isLoading = false;

    private async Task Ingresar()
    {
        errorMessage = "";
        isLoading = true;

        var authClient = new AuthApiClient();
        var request = new LoginRequest
        {
            Username = username,
            Password = password
        };

        try
        {
            var response = await authClient.LoginAsync(request);

            if (response != null && !string.IsNullOrEmpty(response.Token))
            {
                BaseApiClient.Token = response.Token;
                NavigationManager.NavigateTo("/");
            }
            else
            {
                errorMessage = "Usuario o contraseña incorrectos.";
            }
        }
        catch (Exception ex)
        {
            errorMessage = "Error de conexión: " + ex.Message;
        }

        isLoading = false;
    }
}
