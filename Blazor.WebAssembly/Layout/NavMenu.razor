@using API.Clients
@implements IDisposable

<div class="top-row ps-3 navbar navbar-dark">
    <div class="container-fluid">
        <a class="navbar-brand" href="">Gestión Académica</a>
    </div>
</div>

<div class="nav-scrollable">
    <nav class="flex-column">
        <div class="nav-item px-3">
            <NavLink class="nav-link" href="" Match="NavLinkMatch.All">
                <span class="bi bi-house-door-fill-nav-menu" aria-hidden="true"></span> Inicio
            </NavLink>
        </div>

        @if (isAuthenticated)
        {
            <div class="nav-item px-3">
                <NavLink class="nav-link" href="cursos">
                    <span class="bi bi-list-nested-nav-menu" aria-hidden="true"></span> Cursos
                </NavLink>
            </div>
            <div class="nav-item px-3">
                <NavLink class="nav-link" href="especialidades">
                    <span class="bi bi-list-nested-nav-menu" aria-hidden="true"></span> Especialidades
                </NavLink>
            </div>
            <div class="nav-item px-3">
                <NavLink class="nav-link" href="materiacursos">
                    <span class="bi bi-list-nested-nav-menu" aria-hidden="true"></span> Cursos x Materia
                </NavLink>
            </div>
        }
    </nav>
</div>

@code {
    private bool isAuthenticated = false;

    protected override void OnInitialized()
    {
        isAuthenticated = !string.IsNullOrEmpty(BaseApiClient.Token);
        BaseApiClient.AuthenticationStateChanged += OnAuthenticationStateChanged;
    }

    private void OnAuthenticationStateChanged(bool authenticated)
    {
        isAuthenticated = authenticated;
        InvokeAsync(StateHasChanged);
    }

    public void Dispose()
    {
        BaseApiClient.AuthenticationStateChanged -= OnAuthenticationStateChanged;
    }
}
