@inherits LayoutComponentBase
@using API.Clients
@inject NavigationManager Navigation

<div class="page">
    <div class="sidebar">
        <NavMenu />
    </div>

    <main>
        <div class="top-row px-4 d-flex justify-content-end align-items-center gap-3">
            @if (!string.IsNullOrEmpty(BaseApiClient.Token))
            {
                <span class="text-secondary small">Conectado como: <strong>@BaseApiClient.UsuarioActual</strong> <span class="badge bg-secondary ms-1">@BaseApiClient.Rol</span></span>
                <button class="btn btn-outline-danger btn-sm" @onclick="Logout">Cerrar Sesión</button>
            }
        </div>

        <article class="content px-4">
            @Body
        </article>
    </main>
</div>

@code {
    protected override void OnParametersSet()
    {
        // Forzamos la redirección automática si no hay token (igual que el ejemplo)
        if (string.IsNullOrEmpty(BaseApiClient.Token) && !Navigation.Uri.EndsWith("/login"))
        {
            Navigation.NavigateTo("/login");
        }
    }

    private void Logout()
    {
        BaseApiClient.Token = "";
        BaseApiClient.Rol = string.Empty;
        BaseApiClient.UsuarioActual = string.Empty;
        BaseApiClient.IDPersonaActual = 0;
        Navigation.NavigateTo("/login");
    }
}
