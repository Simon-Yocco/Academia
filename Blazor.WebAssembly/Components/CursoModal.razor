@using DTOs
@using API.Clients

@if (showModal)
{
    <div class="modal fade show" tabindex="-1" style="display:block; background-color: rgba(0,0,0,0.5);">
        <div class="modal-dialog modal-dialog-centered">
            <div class="modal-content">
                <div class="modal-header">
                    <h5 class="modal-title">@(mode == FormMode.Add ? "Agregar" : "Editar") Curso</h5>
                    <button type="button" class="btn-close" @onclick="Close"></button>
                </div>
                <div class="modal-body">
                    <EditForm Model="@current" OnValidSubmit="HandleValidSubmit">
                        <DataAnnotationsValidator />
                        
                        @if (mode == FormMode.Update)
                        {
                            <div class="mb-3">
                                <label class="form-label">Id</label>
                                <input type="text" class="form-control" value="@current.ID" readonly />
                            </div>
                        }

                        <div class="mb-3">
                            <label class="form-label">Año Calendario *</label>
                            <InputNumber @bind-Value="current.AnioCalendario" class="form-control" />
                        </div>

                        <div class="mb-3">
                            <label class="form-label">Cupo *</label>
                            <InputNumber @bind-Value="current.Cupo" class="form-control" />
                        </div>

                        <div class="mb-3">
                            <label class="form-label">Descripción *</label>
                            <InputText @bind-Value="current.Descripcion" class="form-control" />
                            @if (validationErrors.ContainsKey("Descripcion"))
                            {
                                <div class="text-danger small">@validationErrors["Descripcion"]</div>
                            }
                        </div>

                        <div class="mb-3">
                            <label class="form-label">Materia *</label>
                            <InputSelect @bind-Value="current.IDmateria" class="form-select">
                                <option value="0">Seleccionar Materia</option>
                                @if (materias != null)
                                {
                                    @foreach (var mat in materias)
                                    {
                                        <option value="@mat.ID">@mat.Descripcion</option>
                                    }
                                }
                            </InputSelect>
                            @if (validationErrors.ContainsKey("Materia"))
                            {
                                <div class="text-danger small">@validationErrors["Materia"]</div>
                            }
                        </div>

                        <div class="mb-3">
                            <label class="form-label">Comisión *</label>
                            <InputSelect @bind-Value="current.IDcomision" class="form-select">
                                <option value="0">Seleccionar Comisión</option>
                                @if (comisiones != null)
                                {
                                    @foreach (var com in comisiones)
                                    {
                                        <option value="@com.ID">@com.Descripcion</option>
                                    }
                                }
                            </InputSelect>
                            @if (validationErrors.ContainsKey("Comision"))
                            {
                                <div class="text-danger small">@validationErrors["Comision"]</div>
                            }
                        </div>

                        <div class="mb-3">
                            <label class="form-label">Docente *</label>
                            <InputSelect @bind-Value="current.IDDocente" class="form-select">
                                <option value="0">Seleccionar Docente</option>
                                @if (docentes != null)
                                {
                                    @foreach (var doc in docentes)
                                    {
                                        <option value="@doc.IDPersona">@doc.Apellido, @doc.Nombre</option>
                                    }
                                }
                            </InputSelect>
                            @if (validationErrors.ContainsKey("Docente"))
                            {
                                <div class="text-danger small">@validationErrors["Docente"]</div>
                            }
                        </div>

                        @if (!string.IsNullOrEmpty(errorMessage))
                        {
                            <div class="alert alert-danger">@errorMessage</div>
                        }

                        <div class="modal-footer px-0 pb-0">
                            <button type="button" class="btn btn-secondary" @onclick="Close">Cancelar</button>
                            <button type="submit" class="btn btn-primary" disabled="@saving">
                                @if (saving)
                                {
                                    <span class="spinner-border spinner-border-sm me-2"></span>
                                }
                                @(mode == FormMode.Add ? "Agregar" : "Actualizar")
                            </button>
                        </div>
                    </EditForm>
                </div>
            </div>
        </div>
    </div>
}

@code {
    [Parameter] public EventCallback OnChanged { get; set; }
    
    private bool showModal = false;
    private FormMode mode = FormMode.Add;
    private CursoDTO current = new CursoDTO();
    private bool saving = false;
    private string errorMessage = string.Empty;
    private Dictionary<string, string> validationErrors = new Dictionary<string, string>();
    
    private List<MateriaDTO>? materias;
    private List<ComisionDTO>? comisiones;
    private List<UsuarioDTO>? docentes;

    public enum FormMode { Add, Update }

    public async Task ShowAddModal()
    {
        mode = FormMode.Add;
        current = new CursoDTO();
        await LoadCombos();
        ClearValidationErrors();
        showModal = true;
        StateHasChanged();
    }

    public async Task ShowEditModal(CursoDTO item)
    {
        mode = FormMode.Update;
        current = new CursoDTO 
        { 
            ID = item.ID, 
            AnioCalendario = item.AnioCalendario,
            Cupo = item.Cupo,
            Descripcion = item.Descripcion,
            IDmateria = item.IDmateria,
            IDcomision = item.IDcomision,
            IDDocente = item.IDDocente
        };
        await LoadCombos();
        ClearValidationErrors();
        showModal = true;
        StateHasChanged();
    }

    private async Task LoadCombos()
    {
        try
        {
            materias = (await MateriaApiClient.GetAllAsync())?.ToList();
            comisiones = (await ComisionApiClient.GetAllAsync())?.ToList();
            var usuarios = await UsuarioApiClient.GetAllAsync();
            docentes = usuarios?.Where(u => u.Rol == "Docente" || u.Persona?.TipoPersona == "Docente").ToList();
        }
        catch (Exception ex)
        {
            errorMessage = $"Error cargando combos: {ex.Message}";
        }
    }

    private async Task HandleValidSubmit()
    {
        if (!Validate()) return;

        try
        {
            saving = true;
            errorMessage = string.Empty;

            if (mode == FormMode.Add)
            {
                await CursoApiClient.AddAsync(current);
            }
            else
            {
                var ok = await CursoApiClient.UpdateAsync(current);
                if (!ok)
                {
                    throw new Exception("No se pudo actualizar el curso.");
                }
            }

            await OnChanged.InvokeAsync();
            Close();
        }
        catch (Exception ex)
        {
            errorMessage = ex.Message;
        }
        finally
        {
            saving = false;
        }
    }

    private bool Validate()
    {
        ClearValidationErrors();
        bool isValid = true;
        if (string.IsNullOrWhiteSpace(current.Descripcion))
        {
            validationErrors["Descripcion"] = "La Descripción es requerida";
            isValid = false;
        }
        if (current.IDmateria <= 0)
        {
            validationErrors["Materia"] = "Debe seleccionar una materia";
            isValid = false;
        }
        if (current.IDcomision <= 0)
        {
            validationErrors["Comision"] = "Debe seleccionar una comisión";
            isValid = false;
        }
        if (current.IDDocente <= 0)
        {
            validationErrors["Docente"] = "Debe seleccionar un docente";
            isValid = false;
        }
        StateHasChanged();
        return isValid;
    }

    private void ClearValidationErrors()
    {
        validationErrors.Clear();
        errorMessage = string.Empty;
    }

    private void Close()
    {
        showModal = false;
        ClearValidationErrors();
        StateHasChanged();
    }
}
