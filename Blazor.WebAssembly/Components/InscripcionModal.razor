@using DTOs
@using API.Clients

@if (showModal)
{
    <div class="modal fade show" tabindex="-1" style="display:block; background-color: rgba(0,0,0,0.5);">
        <div class="modal-dialog modal-dialog-centered">
            <div class="modal-content">
                <div class="modal-header">
                    <h5 class="modal-title">@(mode == FormMode.Add ? "Nueva Inscripción a Cursado" : (BaseApiClient.EsDocente ? "Cargar Calificación" : "Editar Inscripción"))</h5>
                    <button type="button" class="btn-close" @onclick="Close"></button>
                </div>
                <div class="modal-body">
                    <EditForm Model="@current" OnValidSubmit="HandleValidSubmit">
                        <DataAnnotationsValidator />

                        @if (mode == FormMode.Update)
                        {
                            <div class="mb-3">
                                <label class="form-label">Id</label>
                                <input type="text" class="form-control" value="@current.ID" readonly />
                            </div>

                            <div class="mb-3">
                                <label class="form-label">Alumno</label>
                                <input type="text" class="form-control" value="@current.AlumnoNombreCompleto" readonly />
                            </div>
                        }
                        else
                        {
                            @if (BaseApiClient.EsAdmin)
                            {
                                <div class="mb-3">
                                    <label class="form-label">Alumno *</label>
                                    <InputSelect @bind-Value="current.IDAlumno" class="form-select">
                                        <option value="0">Seleccionar Alumno</option>
                                        @if (alumnos != null)
                                        {
                                            @foreach (var alu in alumnos)
                                            {
                                                <option value="@alu.IDPersona">@alu.Apellido, @alu.Nombre (Legajo: @alu.Legajo)</option>
                                            }
                                        }
                                    </InputSelect>
                                    @if (validationErrors.ContainsKey("Alumno"))
                                    {
                                        <div class="text-danger small">@validationErrors["Alumno"]</div>
                                    }
                                </div>
                            }
                        }

                        <div class="mb-3">
                            <label class="form-label">Curso *</label>
                            <InputSelect @bind-Value="current.IDCurso" class="form-select" disabled="@(mode == FormMode.Update && BaseApiClient.EsDocente)">
                                <option value="0">Seleccionar Curso</option>
                                @if (cursos != null)
                                {
                                    @foreach (var cur in cursos)
                                    {
                                        <option value="@cur.ID">@cur.MateriaDescripcion - @cur.ComisionDescripcion (@cur.AnioCalendario) - Cupo: @cur.Cupo</option>
                                    }
                                }
                            </InputSelect>
                            @if (validationErrors.ContainsKey("Curso"))
                            {
                                <div class="text-danger small">@validationErrors["Curso"]</div>
                            }
                        </div>

                        @if (mode == FormMode.Update)
                        {
                            <div class="mb-3">
                                <label class="form-label">Condición *</label>
                                <InputSelect @bind-Value="current.Condicion" class="form-select">
                                    <option value="Inscripto">Inscripto</option>
                                    <option value="Regular">Regular</option>
                                    <option value="Aprobado">Aprobado</option>
                                    <option value="Libre">Libre</option>
                                </InputSelect>
                            </div>

                            <div class="mb-3">
                                <label class="form-label">Nota (1 a 10)</label>
                                <InputNumber @bind-Value="current.Nota" class="form-control" min="1" max="10" />
                            </div>
                        }

                        @if (!string.IsNullOrEmpty(errorMessage))
                        {
                            <div class="alert alert-danger">@errorMessage</div>
                        }

                        <div class="modal-footer px-0 pb-0">
                            <button type="button" class="btn btn-secondary" @onclick="Close">Cancelar</button>
                            <button type="submit" class="btn btn-primary" disabled="@saving">
                                @if (saving)
                                {
                                    <span class="spinner-border spinner-border-sm me-2"></span>
                                }
                                @(mode == FormMode.Add ? "Inscribir" : (BaseApiClient.EsDocente ? "Guardar Nota" : "Guardar Cambios"))
                            </button>
                        </div>
                    </EditForm>
                </div>
            </div>
        </div>
    </div>
}

@code {
    [Parameter] public EventCallback OnChanged { get; set; }

    public enum FormMode { Add, Update }

    private bool showModal = false;
    private FormMode mode = FormMode.Add;
    private AlumnoInscripcionDTO current = new AlumnoInscripcionDTO();
    private bool saving = false;
    private string errorMessage = string.Empty;
    private Dictionary<string, string> validationErrors = new Dictionary<string, string>();

    private List<UsuarioDTO>? alumnos;
    private List<CursoDTO>? cursos;

    public async Task ShowAddModal(int idAlumnoPorDefecto = 0)
    {
        mode = FormMode.Add;
        current = new AlumnoInscripcionDTO
        {
            IDAlumno = idAlumnoPorDefecto,
            Condicion = "Inscripto"
        };
        await LoadCombos();
        ClearValidationErrors();
        showModal = true;
        StateHasChanged();
    }

    public async Task ShowEditModal(AlumnoInscripcionDTO item)
    {
        mode = FormMode.Update;
        current = new AlumnoInscripcionDTO
        {
            ID = item.ID,
            IDAlumno = item.IDAlumno,
            IDCurso = item.IDCurso,
            Condicion = item.Condicion,
            Nota = item.Nota,
            AlumnoNombreCompleto = item.AlumnoNombreCompleto
        };
        await LoadCombos();
        ClearValidationErrors();
        showModal = true;
        StateHasChanged();
    }

    private async Task LoadCombos()
    {
        try
        {
            cursos = (await CursoApiClient.GetAllAsync())?.ToList();

            if (BaseApiClient.EsAdmin)
            {
                var usuarios = await UsuarioApiClient.GetAllAsync();
                alumnos = usuarios?.Where(u => u.Rol == "Alumno" || u.Persona?.TipoPersona == "Alumno").ToList();
            }
        }
        catch (Exception ex)
        {
            errorMessage = $"Error al cargar datos: {ex.Message}";
        }
    }

    private async Task HandleValidSubmit()
    {
        if (!Validate()) return;

        try
        {
            saving = true;
            errorMessage = string.Empty;

            if (mode == FormMode.Add)
            {
                current.Condicion = "Inscripto";
                current.Nota = null;
                await InscripcionApiClient.AddAsync(current);
            }
            else
            {
                var ok = await InscripcionApiClient.UpdateAsync(current);
                if (!ok) throw new Exception("No se pudo actualizar la inscripción.");
            }

            await OnChanged.InvokeAsync();
            Close();
        }
        catch (Exception ex)
        {
            errorMessage = ex.Message;
        }
        finally
        {
            saving = false;
        }
    }

    private bool Validate()
    {
        ClearValidationErrors();
        bool isValid = true;

        if (current.IDAlumno <= 0)
        {
            validationErrors["Alumno"] = "Debe seleccionar un alumno";
            isValid = false;
        }

        if (current.IDCurso <= 0)
        {
            validationErrors["Curso"] = "Debe seleccionar un curso";
            isValid = false;
        }

        StateHasChanged();
        return isValid;
    }

    private void ClearValidationErrors()
    {
        validationErrors.Clear();
        errorMessage = string.Empty;
    }

    private void Close()
    {
        showModal = false;
        ClearValidationErrors();
        StateHasChanged();
    }
}
